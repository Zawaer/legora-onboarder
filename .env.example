# Anthropic — the onboarding agent
ANTHROPIC_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — copy from sye-hackathon-2026/apps/web/.env.local
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ONCE=

# ElevenLabs — the two-minute spoken briefing on /manager.
# Optional: with no key the briefing still composes and renders as text.
# Voice and model are overridable; defaults are Rachel + eleven_turbo_v2_5
# (turbo is roughly half the credit cost, which is the binding constraint).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Slack — the bot surface (scripts/slack-bot.mjs). Setup: docs/slack.md
# Socket Mode, so no public URL and no tunnel are needed.
# api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=
# api.slack.com/apps → your app → Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=
# Where escalations go. Channel ID (C…) is safer than #name — a rename keeps the ID.
# Invite the bot to it first: /invite @Onboarder
SLACK_MANAGER_CHANNEL=
# Optional. Where the bot finds the agent — the same Next server the web panel uses.
ONBOARDER_API_URL=http://localhost:3000
# Optional. Which seeded company and role a bare /onboard starts.
ONBOARDER_COMPANY=legora
ONBOARDER_ROLE=Legal Engineer

# ElevenLabs Scribe — the mic in the chat composer (/api/transcribe).
# Uses the same ELEVENLABS_API_KEY above; no separate credential.
# Optional. Verified live against the API: the only accepted ids are
# scribe_v1, scribe_v1_experimental and scribe_v2. Default is scribe_v2.
ELEVENLABS_STT_MODEL_ID=
