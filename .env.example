# Anthropic — the onboarding agent
#
# Two ways to reach the model. Pick one.
#
# 1. Direct API. Fine for local development. NOT acceptable for a customer's
#    data: it is a transfer to a US company, which under GDPR needs standard
#    contractual clauses we have not executed (docs/security.md §2.1).
ANTHROPIC_API_KEY=
#
# 2. Amazon Bedrock in an EU region. Set AWS_BEDROCK_REGION and every model
#    call goes there instead; leave it empty and nothing changes. This is what
#    we told Apukuski and Fermion in writing we are moving to.
#
#    Before it works: the AWS account needs model access enabled for Anthropic
#    models IN THAT REGION — a per-region opt-in in the Bedrock console, and
#    the first thing to check when you get an auth error. Verify which Claude
#    models are actually available in the region before committing to it.
#
#    eu-central-1 (Frankfurt) is the usual choice. Regional endpoints cost 10%
#    more than global; pay it (docs/model-costs.md §2).
AWS_BEDROCK_REGION=
#
#    Credentials resolve through the standard AWS chain: AWS_BEARER_TOKEN_BEDROCK,
#    then the access key pair below, then the default provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — copy from sye-hackathon-2026/apps/web/.env.local
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ONCE=

# ElevenLabs — the two-minute spoken briefing on /manager.
# Optional: with no key the briefing still composes and renders as text.
# Voice and model are overridable; defaults are Rachel + eleven_turbo_v2_5
# (turbo is roughly half the credit cost, which is the binding constraint).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Slack — the bot surface (scripts/slack-bot.mjs). Setup: docs/slack.md
# Socket Mode, so no public URL and no tunnel are needed.
# api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=
# api.slack.com/apps → your app → Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=
# Where escalations go. Channel ID (C…) is safer than #name — a rename keeps the ID.
# Invite the bot to it first: /invite @Vanav
SLACK_MANAGER_CHANNEL=
# Optional. Where the bot finds the agent — the same Next server the web panel uses.
VANAV_API_URL=http://localhost:3000
# Optional. Which seeded company and role a bare /onboard starts.
VANAV_COMPANY=lexhav
VANAV_ROLE=Legal Engineer

# ElevenLabs Scribe — the mic in the chat composer (/api/transcribe).
# Uses the same ELEVENLABS_API_KEY above; no separate credential.
# Optional. Verified live against the API: the only accepted ids are
# scribe_v1, scribe_v1_experimental and scribe_v2. Default is scribe_v2.
ELEVENLABS_STT_MODEL_ID=

# Linkup — the web rung (lib/web/linkup.ts). https://app.linkup.so
# Optional: with no key, a corpus miss on a general question escalates to a
# human exactly as it does today. Never the /research endpoint — this call sits
# inside a live chat turn and is capped at 5s.
LINKUP_API_KEY=

# Supabase — database, auth and file storage for company profiles, the draft
# approval queue and uploaded onboarding material. Run supabase/schema.sql once
# in the SQL editor after creating the project. Choose an EU region: both
# customers who signed on day one named GDPR and data security as their gate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses every row-level policy. Server only, never NEXT_PUBLIC_, never in a
# client component. A leak here is every customer's data at once.
SUPABASE_SERVICE_ROLE_KEY=

# The Supabase company this bot acts for. Set it and every message to a hire
# waits for an admin unless that company has auto_send on. Unset means there is
# no customer here, so this is the demo and nothing is held.
VANAV_COMPANY_ID=
